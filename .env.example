# Configuración del Asistente Tec.
#
# Copia este archivo como .env (instalar.ps1 lo hace solo y elige los modelos según tu GPU).
# Lo que no aparezca aquí usa el valor por omisión de app/config.py.
# Una variable definida en la terminal gana sobre este archivo.

# ---------- Modelos según la tarjeta gráfica ----------
# 12 GB o más (probado en una RTX 4090 de 16 GB):
#   LLM_MODEL=gemma3:12b
#   WHISPER_MODEL=large-v3-turbo
# 6 a 8 GB (por ejemplo RTX 3050 / 3060 / 4060 de laptop):
#   LLM_MODEL=gemma3:4b
#   WHISPER_MODEL=small
# Mac con Apple Silicon (M1 a M4). Ollama usa la GPU del Mac; Whisper va en el procesador:
#   LLM_MODEL=gemma3:4b        (gemma3:12b con 24 GB de memoria o más)
#   WHISPER_MODEL=small
#   WHISPER_DEVICE=cpu
#   WHISPER_COMPUTE=int8
#   CHATTERBOX_DEVICE=mps      (solo si instalas la voz natural)
# Sin GPU NVIDIA (solo texto; la voz será lenta):
#   LLM_MODEL=gemma3:4b
#   WHISPER_MODEL=small
#   WHISPER_DEVICE=cpu
#   WHISPER_COMPUTE=int8
LLM_MODEL=gemma3:12b
WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=int8_float16

# ---------- Servidores de modelos ----------
# Para usar un servidor con GPU en lugar de esta computadora, apunta aquí (API compatible con OpenAI).
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_MODEL=bge-m3

# ---------- Búsqueda ----------
# Almacén de vectores: local (por omisión, archivo en data/vectores) o chroma. Chroma se cae en
# algunas computadoras con Windows al guardar; úsalo solo si funciona en la tuya. Al cambiarlo, reindexa.
# VECTOR_STORE=local
# Vectores + palabras exactas (siglas, claves, números). false = solo vectores, como antes.
# HYBRID_SEARCH=true

# ---------- Institución ----------
# Aparece en las instrucciones al modelo. Cámbiala para reutilizar el asistente en otra escuela.
# INSTITUTION=Tecnológico de Monterrey (Escuela de Ingeniería y Ciencias)

# ---------- Seguridad ----------
# Clave de la consola y de las rutas de administración de la API. Déjala vacía solo si nadie
# más puede llegar a esta computadora por la red.
ADMIN_TOKEN=

# ---------- Otros ----------
# Minutos sin actividad tras los que se olvida una conversación.
# SESSION_TTL_MINUTES=60
# Tamaño máximo de un archivo subido desde la consola.
# MAX_UPLOAD_MB=50
# Seguridad mínima de Whisper para cambiar de idioma solo cuando el estudiante habla otro.
# LANGUAGE_DETECT_CONFIDENCE=0.8
# Navegador para entrar a Teams: chrome, msedge o chromium.
# TEAMS_BROWSER=msedge
